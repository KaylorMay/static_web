.calendar-page {
  padding-top: 34rpx;
}

.calendar-page .muted-copy {
  display: block;
  margin-bottom: 44rpx;
}

.calendar-timeline {
  border-top: 1rpx solid rgba(198, 166, 106, .3);
}

.calendar-note {
  margin: 76rpx 0 40rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(167, 193, 194, .15);
}

.note-title {
  display: block;
  margin: 16rpx 0;
  color: #e5cf95;
  font-family: "Iowan Old Style", "Noto Serif SC", serif;
  font-size: 48rpx;
  letter-spacing: -.05em;
}

.calendar-note .muted-copy {
  margin-bottom: 0;
}
