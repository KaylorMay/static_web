.stat-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(167, 193, 194, .15);
}

.stat-label,
.stat-unit {
  color: #9aa9aa;
  font-size: 21rpx;
  letter-spacing: .1em;
}

.stat-label {
  flex: 1;
}

.stat-value {
  color: #e5cf95;
  font-family: "Iowan Old Style", "Palatino Linotype", "Noto Serif SC", serif;
  font-size: 58rpx;
  line-height: 1;
}

.stat-unit {
  width: 28rpx;
}
